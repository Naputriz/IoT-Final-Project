# Copy this file to .env and update for your network
# Use "0" to test with your PC/laptop webcam instead of the ESP32-CAM
CAM_STREAM_URL=http://esp32cam.local:81/stream

# MQTT settings (matches Node-RED / Main ESP32 broker)
MQTT_ENABLED=true
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=iot_finpro_naputriz/rc/alert/person

# Detection tuning
MODEL_PATH=yolov8n.onnx
CONF_THRESHOLD=0.45
ALERT_COOLDOWN_SEC=5.0

# Annotated MJPEG output server for Node-RED
HTTP_HOST=0.0.0.0
HTTP_PORT=5000
