[
    {
        "id": "tab_vision_surveillance",
        "type": "tab",
        "label": "ESP32-CAM Vision Surveillance",
        "disabled": false,
        "info": "Standalone Node-RED Dashboard 2.0 flow for ESP32-CAM MJPEG stream, YOLOv8n person detection MQTT alerts, and Flash LED control."
    },
    {
        "id": "mqtt_broker_vision",
        "type": "mqtt-broker",
        "name": "HiveMQ Public Broker",
        "broker": "broker.hivemq.com",
        "port": 1883,
        "clientid": "",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": 4,
        "keepalive": 60,
        "cleansession": true,
        "autoUnsubscribe": true
    },
    {
        "id": "ui_base_vision",
        "type": "ui-base",
        "name": "ESP32-CAM Vision Dashboard",
        "path": "/dashboard",
        "appIcon": "",
        "includeClientData": true,
        "acceptsClientConfig": [
            "ui-notification",
            "ui-control"
        ],
        "showPathInSidebar": false,
        "headerContent": "page",
        "navigationStyle": "default",
        "titleBarStyle": "default",
        "showReconnectNotification": true,
        "notificationDisplayTime": 1,
        "showDisconnectNotification": true,
        "allowInstall": false
    },
    {
        "id": "ui_theme_vision",
        "type": "ui-theme",
        "name": "Default Theme",
        "colors": {
            "surface": "#ffffff",
            "primary": "#0d74ce",
            "bgPage": "#f4f6f9",
            "groupBg": "#ffffff",
            "groupOutline": "#d9dfe7"
        },
        "sizes": {
            "density": "default",
            "pagePadding": "12px",
            "groupGap": "12px",
            "groupBorderRadius": "6px",
            "widgetGap": "10px"
        }
    },
    {
        "id": "ui_page_vision",
        "type": "ui-page",
        "name": "ESP32-CAM Vision",
        "ui": "ui_base_vision",
        "path": "/vision",
        "icon": "video",
        "layout": "grid",
        "theme": "ui_theme_vision",
        "breakpoints": [
            { "name": "Default", "px": 0, "cols": 3 },
            { "name": "Tablet", "px": 576, "cols": 6 },
            { "name": "Small Desktop", "px": 768, "cols": 9 },
            { "name": "Desktop", "px": 1024, "cols": 12 }
        ],
        "order": 1,
        "visible": "true",
        "disabled": "false"
    },
    {
        "id": "ui_group_vision_cam",
        "type": "ui-group",
        "name": "Live Camera Feed",
        "page": "ui_page_vision",
        "width": 6,
        "height": 1,
        "order": 1,
        "showTitle": true,
        "visible": true,
        "disabled": false,
        "groupType": "default"
    },
    {
        "id": "ui_group_vision_ctrl",
        "type": "ui-group",
        "name": "Alerts & Camera Controls",
        "page": "ui_page_vision",
        "width": 6,
        "height": 1,
        "order": 2,
        "showTitle": true,
        "visible": true,
        "disabled": false,
        "groupType": "default"
    },
    {
        "id": "ui_tpl_vision_stream",
        "type": "ui-template",
        "z": "tab_vision_surveillance",
        "group": "ui_group_vision_cam",
        "page": "",
        "ui": "",
        "name": "Annotated MJPEG Stream",
        "order": 1,
        "width": 6,
        "height": 6,
        "head": "",
        "format": "<template>\n  <div style=\"text-align:center;\">\n    <img src=\"http://localhost:5000/stream\" alt=\"ESP32-CAM Live Stream\" style=\"width:100%; max-height:420px; object-fit:contain; border-radius:8px; background:#111;\" />\n    <p style=\"font-size:12px; color:#888; margin-top:6px;\">Source: http://localhost:5000/stream (YOLOv8n Annotated)</p>\n  </div>\n</template>",
        "storeOutMessages": false,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 200,
        "y": 80,
        "wires": [[]]
    },
    {
        "id": "mqtt_in_vision_person",
        "type": "mqtt in",
        "z": "tab_vision_surveillance",
        "name": "Person Alert (MQTT)",
        "topic": "iot_finpro_naputriz/rc/alert/person",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "mqtt_broker_vision",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 160,
        "y": 180,
        "wires": [["fn_format_vision_alert"]]
    },
    {
        "id": "fn_format_vision_alert",
        "type": "function",
        "z": "tab_vision_surveillance",
        "name": "Format Person Alert",
        "func": "const data = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\nconst count = data.count || 1;\nconst conf = Math.round((data.max_confidence || 0) * 100);\nconst timeStr = new Date().toLocaleTimeString();\n\nreturn [\n    { payload: `INTRUDER ALERT: ${count} person (${conf}% conf) at ${timeStr}` },\n    { payload: `${count} person (${conf}%) @ ${timeStr}` }\n];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 180,
        "wires": [["ui_notify_vision"], ["ui_text_vision_alert"]]
    },
    {
        "id": "ui_notify_vision",
        "type": "ui-notification",
        "z": "tab_vision_surveillance",
        "ui": "ui_base_vision",
        "position": "top right",
        "colorDefault": false,
        "color": "#dc2626",
        "displayTime": "5",
        "showCountdown": true,
        "outputs": 0,
        "allowDismiss": true,
        "dismissText": "Close",
        "allowConfirm": false,
        "confirmText": "Confirm",
        "raw": false,
        "className": "",
        "name": "Intruder Popup",
        "x": 650,
        "y": 150,
        "wires": []
    },
    {
        "id": "ui_text_vision_alert",
        "type": "ui-text",
        "z": "tab_vision_surveillance",
        "group": "ui_group_vision_ctrl",
        "order": 1,
        "width": 6,
        "height": 1,
        "name": "Last Detection",
        "label": "Last Alert:",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "x": 650,
        "y": 210,
        "wires": []
    },
    {
        "id": "ui_switch_vision_flash",
        "type": "ui-switch",
        "z": "tab_vision_surveillance",
        "name": "Flash LED Toggle",
        "label": "Camera Flash LED",
        "group": "ui_group_vision_ctrl",
        "order": 2,
        "width": 6,
        "height": 1,
        "passthru": false,
        "decouple": false,
        "topic": "flash",
        "topicType": "str",
        "layout": "row-spread",
        "clickableArea": "switch",
        "onvalue": "on",
        "onvalueType": "str",
        "offvalue": "off",
        "offvalueType": "str",
        "x": 160,
        "y": 300,
        "wires": [["http_req_vision_flash"]]
    },
    {
        "id": "http_req_vision_flash",
        "type": "http request",
        "z": "tab_vision_surveillance",
        "name": "ESP32-CAM /flash",
        "method": "GET",
        "ret": "txt",
        "paytoqs": "ignore",
        "url": "http://esp32cam.local/flash?state={{{payload}}}",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "x": 400,
        "y": 300,
        "wires": [[]]
    },
    {
        "id": "ui_btn_vision_status",
        "type": "ui-button",
        "z": "tab_vision_surveillance",
        "group": "ui_group_vision_ctrl",
        "name": "Check Camera Status",
        "label": "Check ESP32-CAM Status",
        "order": 3,
        "width": 6,
        "height": 1,
        "emulateClick": false,
        "icon": "refresh",
        "iconPosition": "left",
        "payload": "",
        "payloadType": "str",
        "topic": "",
        "topicType": "str",
        "enableClick": true,
        "x": 170,
        "y": 390,
        "wires": [["http_req_vision_status"]]
    },
    {
        "id": "http_req_vision_status",
        "type": "http request",
        "z": "tab_vision_surveillance",
        "name": "ESP32-CAM /status",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://esp32cam.local/status",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "x": 400,
        "y": 390,
        "wires": [["fn_format_vision_status"]]
    },
    {
        "id": "fn_format_vision_status",
        "type": "function",
        "z": "tab_vision_surveillance",
        "name": "Format Status",
        "func": "const s = msg.payload;\nif (!s || !s.ip) {\n    msg.payload = 'Offline / Unreachable';\n} else {\n    msg.payload = `Online (${s.ip}) | RSSI: ${s.rssi} dBm`;\n}\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 390,
        "wires": [["ui_text_vision_status"]]
    },
    {
        "id": "ui_text_vision_status",
        "type": "ui-text",
        "z": "tab_vision_surveillance",
        "group": "ui_group_vision_ctrl",
        "order": 4,
        "width": 6,
        "height": 1,
        "name": "Camera Status",
        "label": "Camera Status:",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "x": 810,
        "y": 390,
        "wires": []
    },
    {
        "id": "global_config_vision",
        "type": "global-config",
        "env": [],
        "modules": {
            "@flowfuse/node-red-dashboard": "1.36.1"
        }
    }
]
