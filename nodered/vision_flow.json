[
    {
        "id": "tab_vision_surveillance",
        "type": "tab",
        "label": "ESP32-CAM Vision Surveillance",
        "disabled": false,
        "info": "Standalone Node-RED flow for ESP32-CAM MJPEG stream, YOLOv8n person detection MQTT alerts, and Flash LED control."
    },
    {
        "id": "mqtt_broker_local",
        "type": "mqtt-broker",
        "name": "HiveMQ Public Broker",
        "broker": "broker.hivemq.com",
        "port": "1883",
        "clientid": "",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "autoUnsubscribe": true
    },
    {
        "id": "ui_tab_surveillance",
        "type": "ui_tab",
        "name": "RC Car Surveillance",
        "icon": "videocam",
        "order": 1,
        "disabled": false,
        "hidden": false
    },
    {
        "id": "ui_group_camera",
        "type": "ui_group",
        "name": "Live Camera Feed",
        "tab": "ui_tab_surveillance",
        "order": 1,
        "disp": true,
        "width": "8",
        "collapse": false
    },
    {
        "id": "ui_group_alerts",
        "type": "ui_group",
        "name": "Alerts & Camera Controls",
        "tab": "ui_tab_surveillance",
        "order": 2,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "ui_template_stream",
        "type": "ui_template",
        "z": "tab_vision_surveillance",
        "group": "ui_group_camera",
        "name": "Annotated MJPEG Stream",
        "order": 1,
        "width": "8",
        "height": "7",
        "format": "<div style=\"text-align:center;\">\n  <img src=\"http://localhost:5000/stream\" alt=\"ESP32-CAM Live Stream\" style=\"width:100%; max-height:420px; object-fit:contain; border-radius:8px; background:#111;\" />\n  <p style=\"font-size:12px; color:#888; margin-top:6px;\">Source: http://localhost:5000/stream (YOLOv8n Annotated)</p>\n</div>",
        "storeOutMessages": false,
        "fwdInMessages": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "x": 200,
        "y": 80,
        "wires": [[]]
    },
    {
        "id": "mqtt_in_person",
        "type": "mqtt in",
        "z": "tab_vision_surveillance",
        "name": "Person Alert (MQTT)",
        "topic": "iot_finpro_naputriz/rc/alert/person",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "mqtt_broker_local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 160,
        "y": 180,
        "wires": [["fn_format_alert"]]
    },
    {
        "id": "fn_format_alert",
        "type": "function",
        "z": "tab_vision_surveillance",
        "name": "Format Person Alert",
        "func": "const data = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\nconst count = data.count || 1;\nconst conf = Math.round((data.max_confidence || 0) * 100);\nconst timeStr = new Date().toLocaleTimeString();\n\nconst toastMsg = {\n    topic: 'INTRUDER ALERT',\n    payload: `Person detected! (${count} person, ${conf}% conf) at ${timeStr}`\n};\n\nconst statusMsg = {\n    payload: `⚠️ ${count} person (${conf}%) @ ${timeStr}`\n};\n\nreturn [toastMsg, statusMsg];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 180,
        "wires": [["ui_toast_alert"], ["ui_text_last_alert"]]
    },
    {
        "id": "ui_toast_alert",
        "type": "ui_toast",
        "z": "tab_vision_surveillance",
        "position": "top right",
        "displayTime": "5",
        "highlight": "red",
        "sendall": true,
        "outputs": 0,
        "ok": "OK",
        "cancel": "",
        "raw": false,
        "topic": "",
        "name": "Intruder Popup",
        "x": 650,
        "y": 150,
        "wires": []
    },
    {
        "id": "ui_text_last_alert",
        "type": "ui_text",
        "z": "tab_vision_surveillance",
        "group": "ui_group_alerts",
        "order": 1,
        "width": "6",
        "height": "2",
        "name": "Last Detection",
        "label": "Last Alert:",
        "format": "{{msg.payload}}",
        "layout": "col-center",
        "x": 650,
        "y": 210,
        "wires": []
    },
    {
        "id": "ui_switch_flash",
        "type": "ui_switch",
        "z": "tab_vision_surveillance",
        "name": "Flash LED Toggle",
        "label": "Camera Flash LED",
        "tooltip": "Toggle ESP32-CAM onboard flash LED",
        "group": "ui_group_alerts",
        "order": 2,
        "width": "6",
        "height": "1",
        "passthru": false,
        "decouple": "false",
        "topic": "flash",
        "style": "",
        "onvalue": "on",
        "onvalueType": "str",
        "onicon": "",
        "oncolor": "",
        "offvalue": "off",
        "offvalueType": "str",
        "officon": "",
        "offcolor": "",
        "x": 160,
        "y": 300,
        "wires": [["http_req_flash"]]
    },
    {
        "id": "http_req_flash",
        "type": "http request",
        "z": "tab_vision_surveillance",
        "name": "ESP32-CAM /flash",
        "method": "GET",
        "ret": "txt",
        "paytoqs": "ignore",
        "url": "http://esp32cam.local/flash?state={{{payload}}}",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "x": 400,
        "y": 300,
        "wires": [[]]
    },
    {
        "id": "ui_btn_status",
        "type": "ui_button",
        "z": "tab_vision_surveillance",
        "name": "Check Camera Status",
        "group": "ui_group_alerts",
        "order": 3,
        "width": "6",
        "height": "1",
        "passthru": false,
        "label": "Check ESP32-CAM Status",
        "tooltip": "",
        "color": "",
        "bgcolor": "",
        "icon": "refresh",
        "payload": "",
        "payloadType": "str",
        "topic": "",
        "x": 170,
        "y": 390,
        "wires": [["http_req_status"]]
    },
    {
        "id": "http_req_status",
        "type": "http request",
        "z": "tab_vision_surveillance",
        "name": "ESP32-CAM /status",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://esp32cam.local/status",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "x": 400,
        "y": 390,
        "wires": [["fn_format_status"]]
    },
    {
        "id": "fn_format_status",
        "type": "function",
        "z": "tab_vision_surveillance",
        "name": "Format Status",
        "func": "const s = msg.payload;\nif (!s || !s.ip) {\n    msg.payload = 'Offline / Unreachable';\n} else {\n    msg.payload = `Online (${s.ip}) | RSSI: ${s.rssi} dBm`;\n}\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 390,
        "wires": [["ui_text_cam_status"]]
    },
    {
        "id": "ui_text_cam_status",
        "type": "ui_text",
        "z": "tab_vision_surveillance",
        "group": "ui_group_alerts",
        "order": 4,
        "width": "6",
        "height": "2",
        "name": "Camera Status",
        "label": "Camera Status:",
        "format": "{{msg.payload}}",
        "layout": "col-center",
        "x": 810,
        "y": 390,
        "wires": []
    }
]
