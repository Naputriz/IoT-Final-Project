        "wires": [["fn_parse_telemetry"]]
    },
    {
        "id": "fn_parse_telemetry",
        "type": "function",
        "z": "tab_rc_surveillance",
        "name": "Split Telemetry",
        "func": "const d = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\nif (!d) return null;\n\nconst stateText = `${d.mode || '-'} | Dir: ${d.dir || '-'} | ${d.bypassing ? 'BYPASSING' : (d.playing ? 'PLAYING' : (d.recording ? 'RECORDING' : 'IDLE'))}`;\nconst pathText = `Steps: ${d.path_count ?? 0} | Step #${d.step_idx ?? 0} (${d.step_rem_ms ?? 0} ms) | Loop: ${d.loop ? 'ON' : 'OFF'}`;\nconst sysText = `NTP: ${d.ntp_time || '--:--:--'} | Sched: ${d.sched_en ? d.sched_time : 'OFF'} | CPU: ${d.cpu_mhz || '-'} MHz ${d.modem_sleep ? '(ModemSleep)' : ''}`;\n\nreturn [\n    { payload: d.front_cm ?? 0 },\n    { payload: d.left_cm ?? 0 },\n    { payload: d.right_cm ?? 0 },\n    { payload: stateText },\n    { payload: pathText },\n    { payload: sysText }\n];",
        "outputs": 6,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 820,
        "wires": [
            ["ui_gauge_front"],
            ["ui_gauge_left"],
            ["ui_gauge_right"],
            ["ui_text_state"],
            ["ui_text_path"],
            ["ui_text_sys"]
        ]
    },
