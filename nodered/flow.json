    {
        "id": "ui_tpl_dpad",
        "type": "ui-template",
        "z": "tab_rc_surveillance",
        "group": "ui_group_drive",
        "page": "",
        "ui": "",
        "name": "RC Car D-Pad",
        "order": 2,
        "width": 6,
        "height": 5,
        "head": "",
        "format": "<template>\n  <div class=\"dpad-wrap\">\n    <div class=\"dpad-grid\">\n      <div></div>\n      <v-btn color=\"primary\" size=\"large\" @pointerdown=\"press('FORWARD')\" @pointerup=\"release()\" @pointerleave=\"release()\">▲ FWD</v-btn>\n      <div></div>\n      <v-btn color=\"primary\" size=\"large\" @pointerdown=\"press('LEFT')\" @pointerup=\"release()\" @pointerleave=\"release()\">◀ LEFT</v-btn>\n      <v-btn color=\"error\" size=\"large\" @click=\"sendDir('STOP')\">■ STOP</v-btn>\n      <v-btn color=\"primary\" size=\"large\" @pointerdown=\"press('RIGHT')\" @pointerup=\"release()\" @pointerleave=\"release()\">RIGHT ▶</v-btn>\n      <div></div>\n      <v-btn color=\"primary\" size=\"large\" @pointerdown=\"press('BACKWARD')\" @pointerup=\"release()\" @pointerleave=\"release()\">▼ REV</v-btn>\n      <div></div>\n    </div>\n    <div class=\"dpad-footer\">\n      <v-switch v-model=\"latchMode\" label=\"Click-Latch Mode (keep moving until STOP)\" density=\"compact\" hide-details></v-switch>\n      <div class=\"dpad-hint\">Last sent: <b>{{ lastDir }}</b> | Keys: W / A / S / D / Space</div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      latchMode: false,\n      lastDir: 'STOP'\n    }\n  },\n  methods: {\n    sendDir(dir) {\n      this.lastDir = dir\n      this.send({ payload: dir })\n    },\n    press(dir) {\n      this.sendDir(dir)\n    },\n    release() {\n      if (!this.latchMode && this.lastDir !== 'STOP') {\n        this.sendDir('STOP')\n      }\n    },\n    onKeyDown(e) {\n      if (['INPUT', 'TEXTAREA'].includes(e.target.tagName)) return\n      const k = e.key.toLowerCase()\n      if (k === 'w' || e.key === 'ArrowUp') this.sendDir('FORWARD')\n      else if (k === 's' || e.key === 'ArrowDown') this.sendDir('BACKWARD')\n      else if (k === 'a' || e.key === 'ArrowLeft') this.sendDir('LEFT')\n      else if (k === 'd' || e.key === 'ArrowRight') this.sendDir('RIGHT')\n      else if (e.code === 'Space') this.sendDir('STOP')\n    }\n  },\n  mounted() {\n    window.addEventListener('keydown', this.onKeyDown)\n  },\n  unmounted() {\n    window.removeEventListener('keydown', this.onKeyDown)\n  }\n}\n</script>\n\n<style>\n.dpad-wrap { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 8px 0; }\n.dpad-grid { display: grid; grid-template-columns: repeat(3, 105px); gap: 8px; }\n.dpad-footer { text-align: center; font-size: 12px; color: #555; }\n.dpad-hint { margin-top: 4px; }\n</style>",
        "storeOutMessages": false,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 160,
