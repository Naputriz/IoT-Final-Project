    {
        "id": "fn_format_all_alerts",
        "type": "function",
        "z": "tab_rc_surveillance",
        "name": "Format Intruder & System Alerts",
        "func": "const data = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\nconst timeStr = new Date().toLocaleTimeString();\nconst ev = data.event || 'alert';\n\nlet text = data.message || ev;\nlet isIntruder = false;\n\nif (ev === 'person_detected') {\n    const count = data.count || 1;\n    const conf = Math.round((data.max_confidence || 0) * 100);\n    text = `PERSON DETECTED (${count} person, ${conf}% conf)`;\n    isIntruder = true;\n} else if (ev === 'pir_motion') {\n    text = `PIR INTRUDER: ${data.message || 'Motion detected!'}`;\n    isIntruder = true;\n}\n\nconst notifyMsg = isIntruder ? { payload: `${text} @ ${timeStr}` } : null;\nconst statusMsg = { payload: `${text} @ ${timeStr}` };\n\nreturn [notifyMsg, statusMsg];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 1290,
        "wires": [["ui_notify_intruder"], ["ui_text_last_alert"]]
    },
