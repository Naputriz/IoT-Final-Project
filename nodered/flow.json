    {
        "id": "fn_build_schedule",
        "type": "function",
        "z": "tab_rc_surveillance",
        "name": "Build Schedule JSON",
        "func": "const t = String(msg.payload || '').trim();\nif (!/^\\d{1,2}:\\d{2}$/.test(t)) {\n    return null;\n}\nmsg.payload = JSON.stringify({ enabled: true, time: t, loop: false });\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 660,
        "wires": [["mqtt_out_schedule"]]
    },
